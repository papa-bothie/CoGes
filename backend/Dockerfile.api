# API FastAPI de CoGes sur le VPS (ADR 0083), derrière Caddy. Construite dans GitHub
# Actions, poussée sur ghcr.io ; le VPS ne fait que la tirer.
#
#   docker build -f Dockerfile.api -t coges/api:local backend
#
# Sans le groupe `ml` (numpy, pandas, statsmodels) : aucun calcul ML dans une requête
# HTTP (règle d'intelligence), il vit dans l'image du worker seulement (ADR 0035).

FROM python:3.12.11-slim-bookworm AS build
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv
COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /usr/local/bin/uv
WORKDIR /srv/coges
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-group ml --no-install-project

FROM python:3.12.11-slim-bookworm AS runtime
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:$PATH" \
    COGES_TRUST_PROXY_HEADERS=true \
    COGES_FORWARDED_ALLOW_IPS=172.30.0.0/24 \
    COGES_API_WORKERS=2
COPY --from=build /opt/venv /opt/venv
WORKDIR /srv/coges
COPY app ./app
RUN useradd --system --no-create-home --uid 10001 coges
USER coges
EXPOSE 8000
HEALTHCHECK --interval=60s --timeout=10s --retries=3 --start-period=30s \
  CMD ["python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/v1/health', timeout=5).status == 200 else 1)"]
# `--proxy-headers` ne fait confiance qu'au réseau Docker de Caddy (`edge`, 172.30.0.0/24) :
# un X-Forwarded-For venu d'ailleurs est ignoré. Les migrations ne sont jamais jouées ici.
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers \"$COGES_API_WORKERS\" --proxy-headers --forwarded-allow-ips \"$COGES_FORWARDED_ALLOW_IPS\" --no-server-header"]
