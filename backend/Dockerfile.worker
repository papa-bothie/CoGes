# Workers Celery, tâches ML et batchs — zone B du Diagramme 2 (hors Vercel).
# Même code applicatif que l'API, autre point d'entrée.
FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:$PATH"

COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /usr/local/bin/uv

WORKDIR /srv/coges

COPY pyproject.toml uv.lock ./
# Le groupe `ml` (numpy, pandas, statsmodels) n'existe que dans cette image (ADR 0035).
RUN uv sync --frozen --no-dev --group ml --no-install-project

COPY app ./app
COPY migrations ./migrations
COPY alembic.ini ./

RUN useradd --system --create-home coges \
    && mkdir -p /var/lib/coges/ml /var/lib/coges/beat \
    && chown coges /var/lib/coges/ml /var/lib/coges/beat
USER coges

# Les migrations ne sont jamais lancées au démarrage : elles sont une étape de
# déploiement (job `migrate` de la CI, ADR 0040). `migrations/` est copié pour qu'une
# restauration ou une reprise manuelle puisse les jouer depuis la même image.
CMD ["celery", "-A", "app.workers.celery_app", "worker", "--loglevel=info"]
