# Secrets et environnement
.env
.env.*
!.env.example
!.env.preprod.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Node / frontend
node_modules/
.next/
.pnpm-store/

# Celery beat : fichier d'état local, régénéré à chaque démarrage
celerybeat-schedule*
celerybeat.pid

# Outils et éditeurs
*.~lock*
.DS_Store
.idea/
.vscode/

# Faux jetons Cloudflare Access des parcours e2e (ADR 0104), régénérés au besoin
.e2e-access/

# Artefacts de modèle CoGes Intelligence (ADR 0035)
.ml-artifacts/

# Secrets transitoires (DSN propriétaire à déposer dans GitHub puis détruire)
*.secret

# Lien local de la CLI Vercel (ids du projet, jamais de secret à versionner)
.vercel/

# Images de comparaison à la maquette (make maquette-check, ~30 Mo) : régénérées à la demande ;
# une PR du lot 3 ajoute celles des écrans qu'elle touche (git add -f).
docs/design/captures/phase-15/comparaison/*.png
