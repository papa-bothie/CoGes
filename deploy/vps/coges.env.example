# Secrets et réglages d'une pile CoGes sur le VPS (ADR 0083). Modèle VERSIONNÉ, valeurs
# VIDES. Le vrai fichier vit hors du dépôt, déposé à la main par le propriétaire :
#   production : /etc/coges/coges.env    (root:coges, mode 0640)
#   préprod    : /etc/coges/preprod.env  (même forme, autres valeurs)
# `deploy.sh` le contrôle avant chaque démarrage (check_runtime_env.py --require-vps).
#
# JAMAIS ici : COGES_DATABASE_URL_OWNER ni aucun DSN de coges_owner (garde-fou 2, ADR
# 0042). Les migrations tournent dans GitHub Actions, pas sur le VPS.

# --- Pile ---------------------------------------------------------------------------
# `production` ou `preprod` : préfixe des noms de services sur le réseau de Caddy.
COGES_STACK=production
COGES_ENV=production
# Domaine public, sans schéma (https imposé) : app.exemple.sn. Préprod : sous-domaine
# preprod.<COGES_DOMAIN>, servi par le même Caddy.
COGES_DOMAIN=
# Adresse de contact Let's Encrypt (expiration, incidents de certificat).
COGES_ACME_EMAIL=
# Version déployée (vX.Y.Z ou SHA), écrite par deploy.sh : ne pas la changer à la main.
COGES_IMAGE_TAG=
COGES_IMAGE_REGISTRY=ghcr.io/papa-bothie/coges

# --- PostgreSQL chez Neon (Francfort), sslmode=require obligatoire ---------------------
# Pooler en mode transaction pour l'API, le worker et beat (ADR 0040).
COGES_DATABASE_URL_APP=
COGES_DATABASE_URL_RELAY=
COGES_DATABASE_URL_ANALYTICS=
COGES_DB_POOLER=transaction

# --- Redis local au VPS (réseau Docker interne, aucun port publié) ---------------------
# 32 caractères au moins : `openssl rand -hex 32`. L'URL Redis est composée par le
# fichier compose, ne pas la poser ici.
COGES_REDIS_PASSWORD=

# --- Sécurité --------------------------------------------------------------------------
# 32 caractères au moins : `openssl rand -base64 48`.
COGES_JWT_SECRET=
# Jeton de GET /api/v1/system/workers (ADR 0077) ; vide = route en 404.
COGES_OPS_TOKEN=

# --- Observabilité ---------------------------------------------------------------------
COGES_SENTRY_DSN=
# JSON {"tâche": "url"} des pings « homme mort » (ADR 0077) ; vide = aucun ping.
COGES_JOB_PING_URLS=
