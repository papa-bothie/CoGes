# Caddy, seul service exposé du VPS (ADR 0083). Certificats Let's Encrypt automatiques,
# HTTP redirigé vers HTTPS, un seul domaine vu par le navigateur (« même origine ») :
#   /api/v1/*  → API FastAPI (un saut de moins que la réécriture de Next)
#   le reste   → front Next.js
# L'administration de la plateforme (ADR 0089) a son sous-domaine, admin.<domaine>,
# protégé par la double authentification obligatoire (ADR 0105), et au choix par
# Cloudflare Access ou une liste d'adresses (ADR 0104, fin du fichier) :
# /api/v1/platform/* n'est servi que là, jamais sur le domaine commerçant.
# La préproduction (sous-domaine preprod.) passe par le même Caddy ; arrêtée, elle
# répond 502.
#
# X-Forwarded-For : Caddy ne fait confiance à aucun en-tête venu du client (aucun
# `trusted_proxies`) et transmet l'adresse du pair TCP. L'API lit l'entrée la plus à
# droite (app/core/deps.py) : un client qui envoie son propre en-tête ne change pas son
# compteur de limitation de débit.
{
	email {$COGES_ACME_EMAIL}
	# Journal des requêtes : ni corps (Caddy ne les journalise jamais), ni cookie, ni jeton.
	log {
		output stdout
		format json
	}
	servers {
		# HTTP/3 ouvert (443/udp), délais pour ne pas garder une connexion lente indéfiniment.
		timeouts {
			read_header 10s
			idle 2m
		}
	}
	# Port interne de l'administration, atteint par le seul conteneur cloudflared
	# (ADR 0104) : l'adresse réelle du client est dans CF-Connecting-IP, crue uniquement
	# venue du réseau `tunnel` (cloudflared et Caddy, rien d'autre).
	servers :8081 {
		trusted_proxies static 172.30.1.0/28
		client_ip_headers CF-Connecting-IP
		timeouts {
			read_header 10s
			idle 2m
		}
	}
}

(entetes) {
	header {
		# Repris de next.config.ts, plus HSTS (HTTPS imposé, un an).
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
		-Via
	}
}

(securite) {
	encode zstd gzip
	import entetes
	log {
		output stdout
		format filter {
			# Ni la chaîne de requête : les recherches y portent des noms et des
			# téléphones de clients (ADR 0088).
			request>uri regexp "\?.*$" ""
			request>headers>Cookie delete
			request>headers>Authorization delete
			request>headers>Idempotency-Key delete
			resp_headers>Set-Cookie delete
		}
	}
}

(maintenance) {
	# Site ou API arrêté : page de maintenance autonome, statut d'origine gardé (ADR 0085).
	handle_errors 502 503 504 {
		import entetes
		root * /srv/maintenance
		rewrite * /maintenance.html
		file_server
	}
}

(pile) {
	import securite
	# Corps de requête bornés aussi à l'entrée (l'API garde ses propres limites, ADR 0042).
	request_body {
		max_size 25MB
	}
	# L'administration ne répond que sur son sous-domaine filtré.
	handle /api/v1/platform/* {
		respond 404
	}
	handle /api/v1/* {
		reverse_proxy {args[0]}-api:8000
	}
	handle {
		reverse_proxy {args[0]}-front:3000
	}
	import maintenance
}

{$COGES_DOMAIN} {
	import pile production
}

preprod.{$COGES_DOMAIN} {
	import pile preprod
}

# Administration de la plateforme (ADR 0089), pile de production seulement. Sa porte
# (ADR 0104, 0105) se choisit par COGES_ADMIN_GATE dans /etc/coges/coges.env :
#   mfa         admin-mfa.caddy        : 443 sans filtre d'adresse, double authentification ;
#   cloudflare  admin-cloudflare.caddy : Cloudflare Access par le tunnel, aucun port public ;
#   ip          admin-ip.caddy         : liste d'adresses sur 443 (retour arrière) ;
#   ssh         admin-ssh.caddy        : secours, port local du VPS par tunnel SSH.
# Sans valeur, `ip` : le comportement d'avant ce lot. Guide : deploy/vps/cloudflare-access.md.
import admin-{$COGES_ADMIN_GATE:ip}.caddy
