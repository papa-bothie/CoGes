# Zone B de préproduction (poste local) — copier en deploy/.env.preprod, jamais versionné.
# Aucune variable propriétaire ici : le DSN coges_owner n'existe que dans le job de
# migration de GitHub (ADR 0042, garde-fou 2).
COGES_ENV=staging
COGES_IMAGE_TAG=preprod

# Neon, hôte « -pooler » (mode transaction), un DSN par rôle.
COGES_DB_POOLER=transaction
COGES_DATABASE_URL_APP=postgresql+psycopg://coges_app:CHANGE-ME@ep-xxx-pooler.eu-central-1.aws.neon.tech/coges?sslmode=require
COGES_DATABASE_URL_RELAY=postgresql+psycopg://coges_relay:CHANGE-ME@ep-xxx-pooler.eu-central-1.aws.neon.tech/coges?sslmode=require
COGES_DATABASE_URL_ANALYTICS=postgresql+psycopg://coges_analytics:CHANGE-ME@ep-xxx-pooler.eu-central-1.aws.neon.tech/coges?sslmode=require

# Offre gratuite de Neon : laisser la base s'endormir (ADR 0040).
COGES_OUTBOX_IDLE_MAX_SECONDS=600

# Redis Cloud, TLS.
COGES_REDIS_URL=rediss://default:CHANGE-ME@redis-00000.c000.eu-west-1-1.ec2.redns.redis-cloud.com:00000/0

# Même clé que l'API de préproduction.
COGES_JWT_SECRET=CHANGE-ME-openssl-rand-hex-32
COGES_SENTRY_DSN=
