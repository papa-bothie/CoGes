# Réglages d'une installation CoGes sur site (ADR 0124). Ceci est le MODÈLE : valeurs vides.
#
# Copiez ce fichier HORS du dossier du programme (par exemple C:\CoGes\reglages\coges.env),
# puis remplissez la première section. Une mise à jour remplace le dossier du programme ;
# elle ne touche jamais à votre copie.
#
# Règles d'écriture : une ligne NOM=valeur, sans espace autour du « = », sans guillemets.
# Guide pas à pas : docs/runbooks/sur-site.md.

# =====================================================================================
# 1. À REMPLIR
# =====================================================================================

# Version de CoGes à installer, donnée par CoGes (exemple : v1.4.0). Jamais « latest ».
# C'est la SEULE ligne à changer pour une mise à jour.
COGES_IMAGE_TAG=

# Huit mots de passe, TOUS DIFFÉRENTS, de 64 caractères hexadécimaux (0-9 et a-f seulement :
# ni « $ », ni « # », ni espace). Dans PowerShell, cette commande en tire un à chaque fois :
#
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); -join ($b | ForEach-Object { $_.ToString('x2') })
#
# Ils ne sont lus par PostgreSQL qu'à la toute première mise en route : les changer ensuite
# ici ne change pas ceux de la base (et empêcherait CoGes de s'y connecter).

# Administrateur de PostgreSQL (dépannage seulement).
COGES_POSTGRES_PASSWORD=
# Propriétaire du schéma : sert uniquement aux migrations (commande « migrate »).
COGES_OWNER_PASSWORD=
# L'application.
COGES_APP_PASSWORD=
# Le relais des événements.
COGES_RELAY_PASSWORD=
# Les calculs de statistiques.
COGES_ANALYTICS_PASSWORD=
# La tâche de nuit des abonnements.
COGES_PLATFORM_PASSWORD=
# Redis (file d'attente et cache).
COGES_REDIS_PASSWORD=
# Signature des sessions des utilisateurs.
COGES_JWT_SECRET=

# Clé de chiffrement, d'un autre format (43 caractères : lettres, chiffres, « - » et « _ »).
# Dans PowerShell :
#
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b).TrimEnd('=').Replace('+','-').Replace('/','_')
#
COGES_MFA_ENCRYPTION_KEY=

# =====================================================================================
# 2. NE PAS TOUCHER (sauf indication du guide)
# =====================================================================================

# Registre public des images de CoGes : aucun compte, aucun jeton.
COGES_IMAGE_REGISTRY=ghcr.io/papa-bothie/coges

# Port et adresse de CoGes sur ce PC. Si le port 80 est déjà pris (guide, « Le port 80 est
# déjà pris »), changez LES DEUX lignes ensemble, par exemple :
#   COGES_HTTP_PORT=8080
#   COGES_PUBLIC_URL=http://localhost:8080
COGES_HTTP_PORT=80
COGES_PUBLIC_URL=http://localhost
