{
  "name": "coges-admin",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3200",
    "build": "next build",
    "start": "next start --port 3200",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "gen:api": "openapi-typescript ../backend/openapi.json -o types/api.ts && prettier --write types/api.ts",
    "check:api": "openapi-typescript ../backend/openapi.json -o types/api.check.ts && prettier --write types/api.check.ts >/dev/null && cmp -s types/api.ts types/api.check.ts; status=$?; rm -f types/api.check.ts; [ $status -eq 0 ] || { echo 'types/api.ts est périmé : lancer pnpm gen:api'; exit 1; }"
  },
  "dependencies": {
    "lucide-react": "1.48.0",
    "next": "16.4.2",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.1",
    "lighthouse": "13.5.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "22.x"
  }
}
