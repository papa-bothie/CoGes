# Copier en `.env` puis remplacer les valeurs. Le fichier `.env` n'est jamais versionné.
# Toutes les valeurs ci-dessous sont factices.
# Le Makefile fait `include .env` : éviter les caractères $ et # dans les mots de passe.
# Si le port 5432 ou 6379 est déjà pris sur la machine, changer POSTGRES_PORT / REDIS_PORT
# ci-dessous **et** les ports des trois DSN.

COGES_ENV=local

# --- PostgreSQL (docker compose) ---
POSTGRES_PASSWORD=change-me-postgres
COGES_OWNER_PASSWORD=change-me-owner
COGES_APP_PASSWORD=change-me-app
COGES_RELAY_PASSWORD=change-me-relay
COGES_ANALYTICS_PASSWORD=change-me-analytics
# Rôle de la sauvegarde externe (ADR 0084) ; vide : le rôle existe, personne ne s'y connecte.
COGES_BACKUP_PASSWORD=
# Administration de la plateforme (ADR 0089) : métadonnées des entreprises, rien de commercial.
COGES_PLATFORM_PASSWORD=change-me-platform
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- DSN applicatifs ---
# Propriétaire : migrations Alembic uniquement, jamais l'API.
COGES_DATABASE_URL_OWNER=postgresql+psycopg://coges_owner:change-me-owner@localhost:5432/coges
# Rôle applicatif : API et workers. Ni superuser, ni BYPASSRLS, pas de DELETE.
COGES_DATABASE_URL_APP=postgresql+psycopg://coges_app:change-me-app@localhost:5432/coges
# Relais de l'outbox : aucun privilège de table, EXECUTE sur trois fonctions (ADR 0032).
COGES_DATABASE_URL_RELAY=postgresql+psycopg://coges_relay:change-me-relay@localhost:5432/coges
# Job analytique : seul rôle autorisé à DELETE, et seulement sur les tables analytiques.
COGES_DATABASE_URL_ANALYTICS=postgresql+psycopg://coges_analytics:change-me-analytics@localhost:5432/coges
# Administration de la plateforme (/api/v1/platform/*) : GRANT colonne par colonne (ADR 0089).
COGES_DATABASE_URL_PLATFORM=postgresql+psycopg://coges_app_platform:change-me-platform@localhost:5432/coges
# Base de test, recréée par la suite pytest : le propriétaire migre, coges_app teste.
COGES_TEST_DATABASE_URL_OWNER=postgresql+psycopg://coges_owner:change-me-owner@localhost:5432/coges_test
COGES_TEST_DATABASE_URL_APP=postgresql+psycopg://coges_app:change-me-app@localhost:5432/coges_test
COGES_TEST_DATABASE_URL_RELAY=postgresql+psycopg://coges_relay:change-me-relay@localhost:5432/coges_test
COGES_TEST_DATABASE_URL_ANALYTICS=postgresql+psycopg://coges_analytics:change-me-analytics@localhost:5432/coges_test
COGES_TEST_DATABASE_URL_PLATFORM=postgresql+psycopg://coges_app_platform:change-me-platform@localhost:5432/coges_test

# --- Redis (file Celery + cache court) ---
COGES_REDIS_URL=redis://localhost:6379/0
# Relais : taille de lot, pause quand la file est vide, plafond de tentatives.
COGES_OUTBOX_BATCH_SIZE=100
COGES_OUTBOX_POLL_INTERVAL_SECONDS=1.0
# Cache court du tableau de bord, et fenêtre de déduplication des alertes.
COGES_DASHBOARD_CACHE_TTL_SECONDS=60
COGES_NOTIFICATION_DEDUPE_HOURS=24

# Relais : plafond d'espacement des passages quand la file est vide (ADR 0040).
# 1 = aucun espacement (local, production). 600 en préproduction sur Neon gratuit.
COGES_OUTBOX_IDLE_MAX_SECONDS=1

# CoGes Intelligence : artefacts de modèle (JSON) hors base, volume du worker (ADR 0035).
# En local, un dossier ignoré par git.
COGES_ML_ARTIFACTS_DIR=./backend/.ml-artifacts

# --- Sécurité ---
# 32 caractères minimum (HMAC-SHA256). Générer avec : openssl rand -hex 32
COGES_JWT_SECRET=change-me-0000000000000000000000000000000000
COGES_JWT_ACCESS_TTL_SECONDS=900
# Access 15 min, refresh 7 jours (ADR 0006).
COGES_JWT_REFRESH_TTL_SECONDS=604800

# --- Connexions et sécurité HTTP (ADR 0040, 0042) ---
# `transaction` derrière le pooler Neon (NullPool + prepare_threshold=None) ; `none` en local.
COGES_DB_POOLER=none
# Origines du frontend autorisées par CORS, séparées par des virgules.
COGES_CORS_ORIGINS=http://localhost:3000
# Derrière Vercel uniquement : l'adresse du client est lue dans X-Forwarded-For.
COGES_TRUST_PROXY_HEADERS=false
# Limitation de débit, requêtes par minute (0 = désactivée).
COGES_RATE_LIMIT_IP_PER_MINUTE=300
COGES_RATE_LIMIT_TENANT_PER_MINUTE=1200
COGES_RATE_LIMIT_LOGIN_PER_MINUTE=10
# Freinage par compte (ADR 0078) : au-delà de 5 échecs en 15 min, attente de 1 min
# doublée à chaque échec, 30 min au plus ; alerte au gérant au 10e échec.
COGES_LOGIN_THROTTLE_FREE_FAILURES=5
COGES_LOGIN_THROTTLE_WINDOW_MINUTES=15
COGES_LOGIN_THROTTLE_MAX_WAIT_MINUTES=30
COGES_LOGIN_THROTTLE_ALERT_AFTER=10
# Compteur de connexion en mémoire quand Redis manque (frein dégradé, par instance).
COGES_LOGIN_THROTTLE_MEMORY_KEYS=10000
# Durée de vie d'un mot de passe provisoire, en heures (ADR 0078).
COGES_TEMP_PASSWORD_TTL_HOURS=48
# Tailles maximales, en octets (import sous la limite Vercel de 4,5 Mo).
COGES_MAX_BODY_BYTES=1048576
COGES_MAX_IMPORT_BYTES=4194304

# --- Observabilité ---
# Vide : Sentry inactif. Renseigné en préproduction et en production seulement.
COGES_SENTRY_DSN=
COGES_SENTRY_TRACES_SAMPLE_RATE=0

# --- Surveillance des workers (ADR 0077, docs/runbooks/workers.md) ---
# Jeton de GET /api/v1/system/workers et de `make ops-status` (openssl rand -hex 32).
# Vide : la route répond 404.
COGES_OPS_TOKEN=
# Retard toléré de l'outbox avant 503 : 600 en production, 900 en préproduction.
COGES_OPS_OUTBOX_MAX_LAG_SECONDS=600
# Pings « homme mort » : JSON {"nom de tâche": "url"} (Healthchecks.io ; `{status}` pour
# Sentry Crons). Vide : aucun ping. Exemple :
# COGES_JOB_PING_URLS={"system.beat_tick": "https://hc-ping.com/<uuid>"}
COGES_JOB_PING_URLS=
# API interrogée par `make ops-status` (défaut http://localhost:8000).
# COGES_OPS_URL=https://coges-api.vercel.app

# --- Entreprise par défaut ---
COGES_DEFAULT_CURRENCY=XOF
COGES_DEFAULT_TIMEZONE=Africa/Dakar
