# Copier en `.env` puis remplacer les valeurs. Le fichier `.env` n'est jamais versionné.
# Toutes les valeurs ci-dessous sont factices.
# Le Makefile fait `include .env` : éviter les caractères $ et # dans les mots de passe.
# Si le port 5432 ou 6379 est déjà pris sur la machine, changer POSTGRES_PORT / REDIS_PORT
# ci-dessous **et** les ports des trois DSN.

COGES_ENV=local

# --- PostgreSQL (docker compose) ---
POSTGRES_PASSWORD=change-me-postgres
COGES_OWNER_PASSWORD=change-me-owner
COGES_APP_PASSWORD=change-me-app
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- DSN applicatifs ---
# Propriétaire : migrations Alembic uniquement, jamais l'API.
COGES_DATABASE_URL_OWNER=postgresql+psycopg://coges_owner:change-me-owner@localhost:5432/coges
# Rôle applicatif : API et workers. Ni superuser, ni BYPASSRLS, pas de DELETE.
COGES_DATABASE_URL_APP=postgresql+psycopg://coges_app:change-me-app@localhost:5432/coges
# Base de test, recréée par la suite pytest : le propriétaire migre, coges_app teste.
COGES_TEST_DATABASE_URL_OWNER=postgresql+psycopg://coges_owner:change-me-owner@localhost:5432/coges_test
COGES_TEST_DATABASE_URL_APP=postgresql+psycopg://coges_app:change-me-app@localhost:5432/coges_test

# --- Redis (file Celery + cache court) ---
COGES_REDIS_URL=redis://localhost:6379/0

# --- Sécurité ---
# 32 caractères minimum (HMAC-SHA256). Générer avec : openssl rand -hex 32
COGES_JWT_SECRET=change-me-0000000000000000000000000000000000
COGES_JWT_ACCESS_TTL_SECONDS=900
COGES_JWT_REFRESH_TTL_SECONDS=1209600

# --- Entreprise par défaut ---
COGES_DEFAULT_CURRENCY=XOF
COGES_DEFAULT_TIMEZONE=Africa/Dakar
